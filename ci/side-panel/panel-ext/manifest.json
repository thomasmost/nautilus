{
  "manifest_version": 3,
  "name": "Nautilus Panel Test",
  "version": "1.0",
  "description": "The side panel's test extension of ci/side-panel (panel_checks.py). Reports to 127.0.0.1:47616.",
  "permissions": ["sidePanel", "tabs", "tabGroups", "debugger"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background/sw.js" },
  "action": { "default_title": "Panel test" },
  "side_panel": { "default_path": "panel.html" },
  "commands": {
    "probe-command": {
      "suggested_key": { "default": "Ctrl+Shift+9", "mac": "MacCtrl+Shift+9" },
      "description": "The command panel_checks.py groups sends"
    }
  },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["browser-facts.js", "probe-page.js"], "run_at": "document_idle" }
  ]
}
